# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editors / IDEs
.idea/
.vscode/
*.code-workspace

# OpenCode (agent config & skills)
.opencode/

# Compiled files
*.dSYM/
*.o
*.exe
*.out

# Solves: keep only source files (.cpp/.txt/.py/.md)
solves/**
!solves/**/
!solves/**/*.cpp
!solves/**/*.txt
!solves/**/*.py
!solves/**/*.md

# Compiled binaries in notes folders
dsa-notes/math-floder/number-theory/*-folder/[a-f]
