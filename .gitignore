# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editors / IDEs
.idea/
*.code-workspace

# OpenCode (agent config & skills) — локальная конфигурация
.opencode/

# Compiled files & build artifacts
*.dSYM/
*.o
*.exe
*.out
.cache/

# Solves: keep only source files (.cpp/.txt/.py/.md)
solves/**
!solves/**/
!solves/**/*.cpp
!solves/**/*.txt
!solves/**/*.py
!solves/**/*.md

# dsa-notes: keep only sources, ignore binaries (Code Runner / F5)
dsa-notes/**/*
!dsa-notes/**/
!dsa-notes/**/*.cpp
!dsa-notes/**/*.md
!dsa-notes/**/*.txt

# Manim render output (nested media/media/, Tex/, __pycache__)
**/media/media/
**/media/Tex/
**/__pycache__/

# Root-level media (stray manim renders)
/media/

# Temp files
temp.txt
visited.txt
