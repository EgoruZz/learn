{
    "clangd.arguments": [
        "--background-index",
        "--header-insertion=never"
    ],
    "code-runner.runInTerminal": true,
    "code-runner.executorMap": {
        "cpp": "cd $dir && clang++ -std=c++17 -g $fileName -o $fileNameWithoutExt && ./$fileNameWithoutExt",
        "pvpython": "/Applications/ParaView-6.2.0-RC1.app/Contents/bin/pvpython $fileName",
        "wolfram": "wolframscript -file $fileName"
    },
    "python.defaultInterpreterPath": "/Users/egorsergeev/stack/manim-env/bin/python"
}